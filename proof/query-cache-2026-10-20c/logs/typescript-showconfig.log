{
    "compilerOptions": {
        "target": "es2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./*"
            ]
        },
        "allowSyntheticDefaultImports": true,
        "resolvePackageJsonExports": true,
        "resolvePackageJsonImports": true,
        "preserveConstEnums": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "strictBuiltinIteratorReturn": true,
        "alwaysStrict": true,
        "useUnknownInCatchVariables": true
    },
    "files": [
        "./next.config.ts",
        "./playwright.config.ts",
        "./proxy.ts",
        "./vitest.config.ts",
        "./app/sw.ts",
        "./app/api/geocode/route.ts",
        "./app/api/pharmacies/route.ts",
        "./app/api/reports/route.ts",
        "./app/api/reports/__tests__/route.test.ts",
        "./lib/db.ts",
        "./lib/device.ts",
        "./lib/distance.ts",
        "./lib/drug-data.ts",
        "./lib/maps.ts",
        "./lib/pharmacy-api.ts",
        "./lib/pharmacy-data.ts",
        "./lib/pharmacy-normalizer.ts",
        "./lib/pharmacy-provider.ts",
        "./lib/phone.ts",
        "./lib/slugs.ts",
        "./lib/supabase.ts",
        "./lib/__tests__/distance.test.ts",
        "./lib/__tests__/maps.test.ts",
        "./lib/__tests__/phone.test.ts",
        "./lib/__tests__/providers.test.ts",
        "./lib/__tests__/slugs.test.ts",
        "./lib/hooks/useGeolocation.ts",
        "./lib/hooks/usePharmacies.ts",
        "./lib/providers/collectapi-provider.ts",
        "./lib/providers/izmir-provider.ts",
        "./lib/providers/mock-provider.ts",
        "./lib/providers/supabase-provider.ts",
        "./tests/app.spec.ts",
        "./tests/cache-area.spec.ts",
        "./tests/distance.test.ts",
        "./tests/example.spec.ts",
        "./tests/izmir-provider.test.ts",
        "./tests/pharmacy-normalizer.test.ts",
        "./tests/phone.test.ts",
        "./tests/provider-fallback.test.ts",
        "./tests/results.spec.ts",
        "./tests/slugs.test.ts",
        "./types/pharmacy.ts",
        "./app/layout.tsx",
        "./app/page.tsx",
        "./app/[city]/[district]/nobetci-eczane/page.tsx",
        "./app/[city]/nobetci-eczane/page.tsx",
        "./app/admin/reports/page.tsx",
        "./app/nobetci-eczane/page.tsx",
        "./components/CityDistrictPicker.tsx",
        "./components/DrugProspectus.tsx",
        "./components/GraphPanel.tsx",
        "./components/HealthDashboard.tsx",
        "./components/InteractiveMap.tsx",
        "./components/KvkkBanner.tsx",
        "./components/KvkkModal.tsx",
        "./components/MapChoiceSheet.tsx",
        "./components/MapSection.tsx",
        "./components/OcrScanner.tsx",
        "./components/OnboardingFlow.tsx",
        "./components/PharmacyCard.tsx",
        "./components/ReportDialog.tsx",
        "./components/ShareCard.tsx",
        "./components/WelcomeScreen.tsx",
        "./components/__tests__/drug-prospectus.test.tsx",
        "./components/__tests__/interactive-map.test.tsx",
        "./components/__tests__/ocr-scanner.test.tsx",
        "./components/__tests__/pharmacy-card-status.test.tsx",
        "./components/__tests__/share-card-status.test.tsx",
        "./components/__tests__/share-card.test.tsx",
        "./tests/home-results.test.tsx",
        "./tests/pharmacy-query-ownership.test.tsx",
        "./.next/types/cache-life.d.ts",
        "./.next/types/root-params.d.ts",
        "./.next/types/routes.d.ts",
        "./.next/types/validator.ts"
    ],
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts"
    ],
    "exclude": [
        "node_modules"
    ]
}
